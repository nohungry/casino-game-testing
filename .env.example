# ⚠️ 本檔含【帳密明文】—— 已 gitignore、且 secret-scan 會擋，但仍請注意：
#   · 絕不 commit、絕不貼進對話、絕不寫進任何報告或截圖
#   · 換機器要重建，不要用任何同步工具帶著走
#   · 只放測試站帳號，絕不放正式環境憑證
# 🔴 前台與後台是【兩套不同憑證】，權限層級也不同：
#   · SITEn_USER/PASS       = 前台會員帳號（進遊戲、下注）
#   · SITEn_ADMIN_USER/PASS = 後台代理帳號（看投注報表、對帳）
#     代理帳號看得到整條代理線的注單，比會員帳號敏感得多 —— 欄位分開放，
#     讀錯欄位會登錯地方而不是默默成功。
# AI 代填帳密的授權範圍見 CLAUDE.md「核心不變量」的登入例外條款。

SITE1_KEY=<填入>
SITE1_USER=<填入>
SITE1_PASS=<填入>
SITE1_LOGIN_URL=<填入，留空＝用 SITE1_HOST 首頁的登入入口>
SITE1_HOST=<填入>
SITE1_LABEL=<填入>
SITE1_ADMIN=<填入>
SITE1_ADMIN_USER=<填入，後台代理帳號 —— 與前台會員帳號不同>
SITE1_ADMIN_PASS=<填入>
SITE1_CURRENCY=<填入>
SITE1_COMPANYCODE=<填入>
SITE1_API_DOMAIN=<填入>
SITE1_LAUNCH_ENDPOINT=<填入>
SITE1_SURFACE=<填入>
SITE1_EXIT=<填入>
SITE1_WALLET=<填入>
SITE1_WALLET_UI=<填入>
SITE1_NOTE=<填入>
SITE2_KEY=<填入>
SITE2_USER=<填入>
SITE2_PASS=<填入>
SITE2_LOGIN_URL=<填入，留空＝用 SITE2_HOST 首頁的登入入口>
SITE2_HOST=<填入>
SITE2_LABEL=<填入>
SITE2_ADMIN=<填入>
SITE2_ADMIN_USER=<填入，後台代理帳號 —— 與前台會員帳號不同>
SITE2_ADMIN_PASS=<填入>
SITE2_CURRENCY=<填入>
SITE2_COMPANYCODE=<填入>
SITE2_API_DOMAIN=<填入>
SITE2_LAUNCH_ENDPOINT=<填入>
SITE2_SURFACE=<填入>
SITE2_EXIT=<填入>
SITE2_CARD_SELECTOR=<填入>
SITE2_NOTE=<填入>
SITE3_KEY=<填入>
SITE3_USER=<填入>
SITE3_PASS=<填入>
SITE3_LOGIN_URL=<填入，留空＝用 SITE3_HOST 首頁的登入入口>
SITE3_HOST=<填入>
SITE3_LABEL=<填入>
SITE3_ADMIN=<填入>
SITE3_ADMIN_USER=<填入，後台代理帳號 —— 與前台會員帳號不同>
SITE3_ADMIN_PASS=<填入>
SITE3_CURRENCY=<填入>
SITE3_COMPANYCODE=<填入>
SITE3_API_DOMAIN=<填入>
SITE3_LAUNCH_ENDPOINT=<填入>
SITE3_SURFACE=<填入>
SITE3_EXIT=<填入>
SITE3_WALLET=<填入>
SITE3_WALLET_UI=<填入>
SITE3_CARD_SELECTOR=<填入>
SITE3_NOTE=<填入>
PLATFORM_API=<填入>
# ACCOUNT 是舊欄位（三站共用同一個帳號名時用）。
# 🔴 新流程請改用每站的 SITEn_USER —— 三站帳號不同時共用欄位會登錯站。
ACCOUNT=<填入，可留空>
LAUNCH_THROTTLE_SEC=<填入>

# ── 無人值守 ──────────────────────────────────────────────
# UNATTENDED=true 時：起手不停等使用者，停等點改成「記錄後跳過、跑下一站」。
# WINDOW_SIZE 必須與 playwright-mcp.unattended.json 的 contextOptions.viewport 完全一致；
# 起手讀到的 viewport 與這個值不符就 fail-fast（多半是 .mcp.json 的 --config
# 沒指到 unattended 那份，或改完沒重啟 Claude Code）。
UNATTENDED=<true 或 false>
WINDOW_SIZE=<例如 1920,1080>
